    "Amoxtli solo puede abrir archivos de texto en UTF-8.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Amoxtli kann nur UTF-8-Textdateien öffnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Amoxtli can only open UTF-8 text files."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Amoxtli solo puede abrir archivos de texto en UTF-8."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Amoxtli ne peut ouvrir que des fichiers texte UTF-8."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Amoxtli può aprire solo file di testo UTF-8."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AmoxtliはUTF-8のテキストファイルのみ開くことができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Amoxtli는 UTF-8 텍스트 파일만 열 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Amoxtli só pode abrir arquivos de texto em UTF-8."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Amoxtli может открывать только текстовые файлы в кодировке UTF-8."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Amoxtli 只能打开 UTF-8 文本文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Amoxtli 只能打開 UTF-8 文字檔案。"
          }
        }
      }
    },
