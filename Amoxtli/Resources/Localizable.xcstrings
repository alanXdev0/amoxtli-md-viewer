    "Comprueba que el archivo exista y que tengas permiso para abrirlo.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe, ob die Datei existiert und du die Berechtigung hast, sie zu öffnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make sure the file exists and that you have permission to open it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba que el archivo exista y que tengas permiso para abrirlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez que le fichier existe et que vous êtes autorisé à l’ouvrir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica che il file esista e che tu abbia il permesso di aprirlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルが存在し、開くためのアクセス権があることを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일이 있는지, 그리고 파일을 열 권한이 있는지 확인하십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique se o arquivo existe e se você tem permissão para abri-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Убедитесь, что файл существует и у вас есть разрешение на его открытие."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请确认文件存在，并且你有权限打开它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請確認檔案存在，且你有權限打開。"
          }
        }
      }
    },
