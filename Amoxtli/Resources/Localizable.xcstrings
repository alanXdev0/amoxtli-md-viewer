{
  "sourceLanguage": "en",
  "strings": {
    "%@ Ábrelo solo si confías en quien escribió este documento.\n\n%@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Öffne ihn nur, wenn du der Person vertraust, die dieses Dokument geschrieben hat.\n\n%2$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Only open it if you trust whoever wrote this document.\n\n%2$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Ábrelo solo si confías en quien escribió este documento.\n\n%@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Ouvrez-le uniquement si vous faites confiance à l’auteur de ce document.\n\n%2$@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Aprilo solo se ti fidi di chi ha scritto questo documento.\n\n%2$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ この書類の作成者を信頼できる場合にのみ開いてください。\n\n%2$@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 이 문서의 작성자를 신뢰하는 경우에만 여십시오.\n\n%2$@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Abra somente se você confia em quem escreveu este documento.\n\n%2$@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Открывайте, только если доверяете автору этого документа.\n\n%2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 请仅在信任此文档作者时打开。\n\n%2$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 請僅在信任此文件作者時打開。\n\n%2$@"
          }
        }
      }
    },
