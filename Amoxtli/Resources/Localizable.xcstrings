    "Puede que se haya movido o eliminado. Elígela de nuevo para seguir leyendo.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Er wurde möglicherweise bewegt oder gelöscht. Wähle ihn erneut aus, um weiterzulesen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It may have been moved or deleted. Choose it again to keep reading."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede que se haya movido o eliminado. Elígela de nuevo para seguir leyendo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il a peut-être été déplacé ou supprimé. Choisissez-le à nouveau pour continuer la lecture."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Potrebbe essere stata spostata o eliminata. Sceglila di nuovo per continuare a leggere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "移動または削除された可能性があります。読み続けるには、もう一度選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이동되었거나 삭제되었을 수 있습니다. 계속 읽으려면 다시 선택하십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ela pode ter sido movida ou apagada. Escolha-a novamente para continuar lendo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Возможно, она была перемещена или удалена. Выберите ее снова, чтобы продолжить чтение."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它可能已被移动或删除。请重新选择以继续阅读。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "它可能已被移動或刪除。請重新選擇以繼續閱讀。"
          }
        }
      }
    },
